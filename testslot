#!/usr/bin/env python3
"""testslot: one machine-wide test gate. This is the entry script: the code is the package in lib/testslot, found beside
this file's real path (so a link to it on PATH works too). Run `testslot --help` for the usage."""
import os
import sys

sys.dont_write_bytecode = True  # running from a checkout must not leave __pycache__ in the tree or in an install copy
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))

from testslot import cli  # noqa: E402  (every module is imported now, none later, so a mid-run upgrade cannot change a live run)

if __name__ == "__main__":
    sys.exit(cli.main())
